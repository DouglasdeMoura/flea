#!/bin/bash
# Writes ui/js/Keymap.js from keys.toml, see AGENTS.md "The key table is generated".
set -u
cd "$(dirname "$0")/.." || exit 1

src=keys.toml
out=${1:-ui/js/Keymap.js}

[ -f "$src" ] || { echo "flea-keymap-gen: $src is missing" >&2; exit 1; }

# Sample input: a [[text]] block is 'char = "j"' then 'action = "cursorDown"', printed as 'j<tab>cursorDown'.
pairs() {
  local want="[[$1]]" field="$2"
  local inblock=0 key="" name eq value
  while read -r name eq value || [ -n "$name" ]; do
    case "$name" in
      "$want") inblock=1; key=""; continue ;;
      '['*)    inblock=0; continue ;;
    esac
    [ "$inblock" = 1 ] || continue
    value=${value#\"}
    value=${value%\"}
    case "$name" in
      "$field") key=$value ;;
      action)   printf '%s\t%s\n' "$key" "$value" ;;
    esac
  done < "$src"
}

# Sample input: a [[sheet]] block is 'keys = "j k"', then 'action = "cursorDown"', then
# 'label = "move"', printed as 'j k<tab>cursorDown<tab>move'. label is printed last, so it must be
# written last in the block, the same rule pairs() above puts on action.
sheet() {
  local inblock=0 keys="" action="" name eq value
  while read -r name eq value || [ -n "$name" ]; do
    case "$name" in
      "[[sheet]]") inblock=1; keys=""; action=""; continue ;;
      '['*)        inblock=0; continue ;;
    esac
    [ "$inblock" = 1 ] || continue
    value=${value#\"}
    value=${value%\"}
    case "$name" in
      keys)   keys=$value ;;
      action) action=$value ;;
      label)  printf '%s\t%s\t%s\n' "$keys" "$action" "$value" ;;
    esac
  done < "$src"
}

# Sample input: a [[pointer]] block is 'where = "neighbour"', then 'press = "left x2"', then
# 'row = "file"', then 'does = "open"', then 'label = "open the file"', printed tab separated in that
# order.
# label is printed last, so it must be written last in the block, the same rule the two above put on
# their own final field.
pointer() {
  local inblock=0 where="" press="" row="" does="" name eq value
  while read -r name eq value || [ -n "$name" ]; do
    case "$name" in
      "[[pointer]]") inblock=1; where=""; press=""; row=""; does=""; continue ;;
      '['*)          inblock=0; continue ;;
    esac
    [ "$inblock" = 1 ] || continue
    value=${value#\"}
    value=${value%\"}
    case "$name" in
      where) where=$value ;;
      press) press=$value ;;
      row)   row=$value ;;
      does)  does=$value ;;
      label) printf '%s\t%s\t%s\t%s\t%s\n' "$where" "$press" "$row" "$does" "$value" ;;
    esac
  done < "$src"
}

# Sample input: a [[preset]] block is 'name = "mac"', then 'mods = "ctrl"', then 'key = "1"', then
# 'keys = "ctrl-1"', then 'action = "viewList"', then 'label = "list view"', printed tab separated in
# that order. label is printed last, so it must be written last in the block, the same rule the three
# above put on their own final field.
preset() {
  local inblock=0 name_="" mods="" key="" keys="" action="" name eq value
  while read -r name eq value || [ -n "$name" ]; do
    case "$name" in
      "[[preset]]") inblock=1; name_=""; mods=""; key=""; keys=""; action=""; continue ;;
      '['*)         inblock=0; continue ;;
    esac
    [ "$inblock" = 1 ] || continue
    value=${value#\"}
    value=${value%\"}
    case "$name" in
      name)   name_=$value ;;
      mods)   mods=$value ;;
      key)    key=$value ;;
      keys)   keys=$value ;;
      action) action=$value ;;
      label)  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name_" "$mods" "$key" "$keys" "$action" "$value" ;;
    esac
  done < "$src"
}

# Sample input: [digits] holds 'from = 1', 'to = 9' and 'prefix = "tab"'; those three names are unique in the file.
digit() {
  grep "^$1 = " "$src" | cut -d= -f2 | tr -d ' "'
}

# An empty table would generate an empty POINTER array, and a checklist derived from an empty array
# passes by having nothing in it, which is exactly what the [digits] blind spot cost this project.
if [ -z "$(pointer)" ]; then
  echo "flea-keymap-gen: the [[pointer]] table in $src is missing or unreadable" >&2
  exit 1
fi

if [ -z "$(preset)" ]; then
  echo "flea-keymap-gen: the [[preset]] table in $src is missing or unreadable" >&2
  exit 1
fi

from=$(digit from)
to=$(digit to)
prefix=$(digit prefix)
if [ -z "$from" ] || [ -z "$to" ] || [ -z "$prefix" ]; then
  echo "flea-keymap-gen: the [digits] table in $src is incomplete" >&2
  exit 1
fi

{
  echo ".pragma library"
  echo
  echo "// Generated from keys.toml by tools/flea-keymap-gen. Do not edit."
  echo "// The selected Mac/Windows preset. A .pragma library holds one copy per QML engine, so"
  echo "// ui/ViewState.qml sets it once and every caller of lookup() below follows without a"
  echo "// second wire; an unknown name falls back to mac rather than leaving the map empty."
  echo "var preset = \"mac\""
  echo "function setPreset(name) { preset = name === \"windows\" ? \"windows\" : \"mac\" }"
  echo
  echo "// The [[preset]] rows of keys.toml, for ui/SettingsPanel.qml's Keys section. code is the Qt"
  echo "// name the overlay below matches on, so a row here and the binding are the same keys.toml row."
  echo "var PRESET_KEYS = ["
  preset | while IFS=$'\t' read -r n m k caps a l; do
    if [ "$m" = ctrlshift ]; then shift_state=true; else shift_state=false; fi
    echo "    { preset: \"$n\", ctrl: true, shift: $shift_state, code: \"Key_$k\", keys: \"$caps\", action: \"$a\", label: \"$l\" },"
  done
  echo "]"
  echo
  echo "// Checked before every shared table, so a preset can claim a chord the shared tables bind."
  echo "function lookupPreset(name, key, text, modifiers) {"
  echo "    var ctrl = (modifiers & Qt.ControlModifier) !== 0"
  echo "    var shift = (modifiers & Qt.ShiftModifier) !== 0"
  preset | while IFS=$'\t' read -r n m k caps a l; do
    if [ "$m" = ctrlshift ]; then shift_state=shift; else shift_state="!shift"; fi
    echo "    if (name === \"$n\" && ctrl && $shift_state && key === Qt.Key_$k) return \"$a\""
  done
  echo "    return \"\""
  echo "}"
  echo
  echo "function lookup(key, text, modifiers) {"
  echo "    var chosen = lookupPreset(preset, key, text, modifiers)"
  echo "    if (chosen.length > 0)"
  echo "        return chosen"
  echo "    if (modifiers & Qt.ControlModifier) {"
  # A shifted chord is checked before the plain ctrl rows and falls through when unmatched, so a
  # ctrl-shift chord nobody bound still reaches the ctrl row for its key.
  echo "        if (modifiers & Qt.ShiftModifier) {"
  pairs ctrlshift key | while IFS=$'\t' read -r k a; do
    echo "            if (key === Qt.Key_$k) return \"$a\""
  done
  echo "        }"
  pairs ctrl key | while IFS=$'\t' read -r k a; do
    echo "        if (key === Qt.Key_$k) return \"$a\""
  done
  echo "        return \"\""
  echo "    }"
  echo
  # No early return here, unlike ctrl above: a shift-modified letter is already distinguished by
  # its own capital text (see keys.toml), so an unmatched shift+key falls through to that switch.
  echo "    if (modifiers & Qt.ShiftModifier) {"
  pairs shift key | while IFS=$'\t' read -r k a; do
    echo "        if (key === Qt.Key_$k) return \"$a\""
  done
  echo "    }"
  echo
  echo "    switch (key) {"
  pairs code key | while IFS=$'\t' read -r k a; do
    echo "    case Qt.Key_$k: return \"$a\""
  done
  echo "    }"
  echo
  echo "    switch (text) {"
  pairs text char | while IFS=$'\t' read -r c a; do
    echo "    case \"$c\": return \"$a\""
  done
  echo "    }"
  echo
  echo "    if (text >= \"$from\" && text <= \"$to\") {"
  echo "        return \"$prefix\" + text"
  echo "    }"
  echo "    return \"\""
  echo "}"
  echo
  echo "// The keymap sheet ui/KeymapSheet.qml draws, from the [[sheet]] table in keys.toml."
  echo "var SHEET = ["
  sheet | while IFS=$'\t' read -r k a l; do
    echo "    { keys: \"$k\", action: \"$a\", label: \"$l\" },"
  done
  echo "]"
  echo
  echo "// The pointer contract, from the [[pointer]] table in keys.toml. ui/js/Tap.js is what makes"
  echo "// it true and tests/js/tap.js is what holds the two together."
  echo "var POINTER = ["
  pointer | while IFS=$'\t' read -r w p r d l; do
    echo "    { where: \"$w\", press: \"$p\", row: \"$r\", does: \"$d\", label: \"$l\" },"
  done
  echo "]"
} > "$out"
